# API server
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
PUBLIC_APP_URL=https://your-domain.example

# Postgres 16
DATABASE_URL=postgres://studio_user:replace-me@127.0.0.1:5432/studio_reporting
POSTGRES_SSL=false
POSTGRES_POOL_MAX=4
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECTION_TIMEOUT_MS=5000
POSTGRES_STATEMENT_TIMEOUT_MS=60000
POSTGRES_LEGACY_ROW_LOAD_LIMIT=100000
POSTGRES_AUTO_MIGRATE=true

# Upload limits
UPLOAD_MAX_FILE_BYTES=26214400

# Session auth
AUTH_ENABLED=true
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=studio.sid
SESSION_TTL_HOURS=12
# Semicolon-separated email:bcrypt_hash entries, max 5 users.
AUTH_WHITELIST_USERS=admin@example.com:$2a$12$replaceWithBcryptHash

# Quickbase is still configured inside the studio document/app profiles.
# Use the application UI to configure realm, app id, user token, table ids, and saved report ids.

# Automation and SendGrid
AUTOMATION_ENABLED=true
AUTOMATION_CRON=0 * * * *
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=reports@example.com
